{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 1420
    },
    {
      "name": "vite-real",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:vite"
      ],
      "port": 1420
    },
    {
      "name": "app-attach",
      "url": "http://localhost:1420"
    },
    {
      "name": "prototype-attach",
      "url": "http://localhost:4174"
    },
    {
      "name": "prototype",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "vite",
        "-c",
        "scripts/vite.prototype.config.mjs"
      ],
      "port": 4174
    }
  ]
}
