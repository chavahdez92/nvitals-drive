{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos m\u00ednimos: la ventana principal y las ventanas ocultas de impresi\u00f3n de reportes.",
  "windows": [
    "main",
    "print-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}